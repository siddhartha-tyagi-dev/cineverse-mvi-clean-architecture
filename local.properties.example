# Copy this file to local.properties and keep your real values local.
# local.properties is ignored by Git.

# Android SDK path is generated by Android Studio, for example:
# sdk.dir=C\:\\Users\\your-name\\AppData\\Local\\Android\\Sdk

# Create a TMDB API Read Access Token from your TMDB account settings.
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here
